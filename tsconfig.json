{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "experimentalDecorators": false,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "src",
    "test",
    "examples"
  ]
}
